{
  "openapi": "3.1.0",
  "info": {
    "title": "bia",
    "description": "Workflows as data, run from Postgres. Every endpoint fails with the same error body: a stable `code`, a `message`, and `diagnostics` when a Definition was at fault.",
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "probes"
        ],
        "summary": "Answers while the process serves HTTP, whatever the state of the database.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "probes"
        ],
        "summary": "Answers once the database is reachable and every migration this build needs is applied.",
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "503": {
            "description": "Not ready; `code` is `not_ready`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/v1/schema": {
      "get": {
        "tags": [
          "schema"
        ],
        "summary": "The DSL JSON Schema and every Action with its param and output schemas and examples. Needs\nan `admin` or `agent` Token, since the catalogue describes this server's configuration.",
        "operationId": "get_schema",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaDocument"
                }
              }
            }
          },
          "401": {
            "description": "No Token, or one that is unknown or revoked; `code` is `missing_token` or\n`invalid_token`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "The Token's Scope does not allow this route; `code` is `insufficient_scope`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "token": []
          }
        ]
      }
    },
    "/v1/tokens": {
      "get": {
        "tags": [
          "tokens"
        ],
        "summary": "Every Token, revoked ones included, without their values. Needs an `admin` Token.",
        "operationId": "list_tokens",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenList"
                }
              }
            }
          },
          "401": {
            "description": "No Token, or one that is unknown or revoked; `code` is `missing_token` or\n`invalid_token`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "The Token's Scope does not allow this route; `code` is `insufficient_scope`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "token": []
          }
        ]
      },
      "post": {
        "tags": [
          "tokens"
        ],
        "summary": "Creates a Token and returns its value, once. Needs an `admin` Token.",
        "operationId": "create_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedToken"
                }
              }
            }
          },
          "400": {
            "description": "`malformed_request`, e.g. `webhook` missing or misplaced.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "No Token, or one that is unknown or revoked; `code` is `missing_token` or\n`invalid_token`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "The Token's Scope does not allow this route; `code` is `insufficient_scope`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "token": []
          }
        ]
      }
    },
    "/v1/tokens/bootstrap": {
      "post": {
        "tags": [
          "tokens"
        ],
        "summary": "Mints the first admin Token of a fresh install, authenticated with the server's bootstrap\nkey (`BIA_BOOTSTRAP_KEY`) instead of a Token. It refuses once an unrevoked admin Token\nexists, so the key cannot mint a second one; `bia token create --bootstrap` calls it.",
        "operationId": "bootstrap_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BootstrapRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedToken"
                }
              }
            }
          },
          "401": {
            "description": "No bootstrap key, or the wrong one; `code` is `missing_token` or `invalid_token`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`bootstrap_disabled`: the server has no bootstrap key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`already_bootstrapped`: an unrevoked admin Token exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bootstrap_key": []
          }
        ]
      }
    },
    "/v1/tokens/{token_id}/revoke": {
      "post": {
        "tags": [
          "tokens"
        ],
        "summary": "Revokes a Token at once; revoking it again changes nothing. Needs an `admin` Token, which\nmay revoke itself. With every admin Token revoked, only bootstrapping can mint another.",
        "operationId": "revoke_token",
        "parameters": [
          {
            "name": "token_id",
            "in": "path",
            "description": "The Token's `id`.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenInfo"
                }
              }
            }
          },
          "401": {
            "description": "No Token, or one that is unknown or revoked; `code` is `missing_token` or\n`invalid_token`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "The Token's Scope does not allow this route; `code` is `insufficient_scope`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "`token_not_found`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "token": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ActionEffect": {
        "type": "string",
        "description": "Whether an Action can change anything outside the Run. A Dry Run executes `pure` Actions\nand gives `side_effecting` ones a Mock.",
        "enum": [
          "pure",
          "side_effecting"
        ]
      },
      "ActionEntry": {
        "type": "object",
        "description": "An Action a Step can name in `action`.",
        "required": [
          "name",
          "category",
          "description",
          "effect",
          "dangerous",
          "enabled",
          "param_schema",
          "output_schema",
          "examples"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "dangerous": {
            "type": "boolean",
            "description": "Disabled unless enabled in server config, and only publishable with an `admin` Token."
          },
          "description": {
            "type": "string"
          },
          "effect": {
            "$ref": "#/components/schemas/ActionEffect"
          },
          "enabled": {
            "type": "boolean",
            "description": "A Version that uses a disabled Action cannot be published."
          },
          "examples": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActionExampleEntry"
            },
            "description": "Example calls, also the source of Mocks in a Dry Run."
          },
          "name": {
            "type": "string",
            "description": "`category.operation`, e.g. `http.request`."
          },
          "output_schema": {
            "type": "object",
            "description": "The JSON Schema of the Step's Output, read by later Steps as `steps.<id>.output`."
          },
          "param_schema": {
            "type": "object",
            "description": "The JSON Schema a Step's `params` must satisfy once its Templates are resolved."
          }
        }
      },
      "ActionExampleEntry": {
        "type": "object",
        "required": [
          "description",
          "params",
          "output"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "output": {},
          "params": {
            "type": "object"
          }
        }
      },
      "BootstrapRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "What the Token is for, e.g. `admin`.",
            "example": "admin"
          }
        },
        "additionalProperties": false
      },
      "CreatedToken": {
        "type": "object",
        "description": "A Token just created, with its value.",
        "required": [
          "token",
          "value"
        ],
        "properties": {
          "token": {
            "$ref": "#/components/schemas/TokenInfo"
          },
          "value": {
            "type": "string",
            "description": "Send it as `Authorization: Bearer <value>`. Shown only in this response: bia keeps a\nhash of it, so a lost value cannot be recovered, only replaced.",
            "example": "bia_6f1c…"
          }
        }
      },
      "Diagnostic": {
        "type": "object",
        "description": "One validation finding about a Definition.",
        "required": [
          "path",
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "A stable snake_case phrase naming the problem, listed in `docs/dsl.md`."
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation. Its wording may change; match on `code`."
          },
          "path": {
            "type": "string",
            "description": "JSON Pointer to the offending value, e.g. `/steps/0/params/url`."
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "suggestion": {
            "type": [
              "string",
              "null"
            ],
            "description": "A likely fix, such as the nearest known name."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "The body of every error response.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            },
            "description": "The Diagnostics behind the error, in document order. Absent when none apply."
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation. Its wording may change; match on `code`."
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "A stable identifier for what went wrong with a request. Agents match on it, so codes may be\nadded, but renaming or removing one needs an ADR (ADR-0042).",
        "enum": [
          "route_not_found",
          "method_not_allowed",
          "malformed_request",
          "request_too_large",
          "invalid_definition",
          "missing_token",
          "invalid_token",
          "insufficient_scope",
          "token_not_found",
          "bootstrap_disabled",
          "already_bootstrapped",
          "not_ready",
          "internal_error"
        ]
      },
      "NewTokenRequest": {
        "type": "object",
        "required": [
          "name",
          "scope"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "What the Token is for, e.g. `claude-desktop`. Need not be unique.",
            "example": "claude-desktop"
          },
          "scope": {
            "$ref": "#/components/schemas/ScopeName"
          },
          "webhook": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/WebhookBinding",
                "description": "Required with the `webhook` Scope, and refused with any other."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "SchemaDocument": {
        "type": "object",
        "description": "The DSL's JSON Schemas and the Action catalogue.",
        "required": [
          "definition",
          "queue",
          "actions"
        ],
        "properties": {
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActionEntry"
            },
            "description": "Every Action this server knows, disabled ones included, ordered by name."
          },
          "definition": {
            "type": "object",
            "description": "The JSON Schema (draft 2020-12) a Definition must satisfy. Passing it is the first\nlayer of validation; Diagnostics report the rest."
          },
          "queue": {
            "type": "object",
            "description": "The JSON Schema of a `kind: queue` resource file."
          }
        }
      },
      "ScopeName": {
        "type": "string",
        "description": "What a Token may do.",
        "enum": [
          "admin",
          "agent",
          "webhook"
        ]
      },
      "Severity": {
        "type": "string",
        "description": "Only errors block publishing.",
        "enum": [
          "error",
          "warning"
        ]
      },
      "Status": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "TokenInfo": {
        "type": "object",
        "description": "A Token, without its value.",
        "required": [
          "id",
          "name",
          "scope",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the Token last authenticated a request, to the minute."
          },
          "name": {
            "type": "string"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Once set, the Token authenticates nothing."
          },
          "scope": {
            "$ref": "#/components/schemas/ScopeName"
          },
          "webhook": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/WebhookBinding",
                "description": "Present with the `webhook` Scope."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "TokenList": {
        "type": "object",
        "required": [
          "tokens"
        ],
        "properties": {
          "tokens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TokenInfo"
            },
            "description": "Every Token, revoked ones included, oldest first."
          }
        }
      },
      "WebhookBinding": {
        "type": "object",
        "description": "The webhook Trigger a `webhook` Token is bound to.",
        "required": [
          "workflow_id",
          "trigger_id"
        ],
        "properties": {
          "trigger_id": {
            "type": "string",
            "example": "signup"
          },
          "workflow_id": {
            "type": "string",
            "example": "onboarding-email"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bootstrap_key": {
        "type": "http",
        "scheme": "bearer",
        "description": "The key the server was started with in `BIA_BOOTSTRAP_KEY`."
      },
      "token": {
        "type": "http",
        "scheme": "bearer",
        "description": "A Token, `bia_` and 64 hex digits. Its Scope decides which routes it may call: `admin` everything, `agent` all but publishing, activation and administration, `webhook` only its own webhook Trigger."
      }
    }
  }
}
