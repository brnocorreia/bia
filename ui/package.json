{
  "name": "bia-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen:routes": "tsr generate",
    "gen:api": "openapi-typescript ../crates/bia-server/openapi.json -o src/api/schema.gen.ts",
    "check:api": "pnpm gen:api && git diff --exit-code -- src/api/schema.gen.ts",
    "dev": "pnpm gen:routes && vite",
    "build": "pnpm gen:routes && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm gen:routes && tsc --noEmit",
    "lint": "pnpm gen:routes && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm gen:routes && vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:embedded": "pnpm build && BIA_E2E_EMBEDDED=1 playwright test"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
